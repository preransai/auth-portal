<%- include('../partials/auth-start', { title: 'Forgot password', formNo: 'AP-3' }) %>
<div class="auth__header">
  <h1 class="auth__title">Forgot your password?</h1>
  <p class="auth__subtitle">Enter your email and we'll send you a link to choose a new one.</p>
</div>

<% if (locals.formError) { %>
<div class="alert alert--error" role="alert"><%- include('../partials/icon', { name: 'alert' }) %><p><%= formError %></p></div>
<% } %>

<% if (locals.sent) { %>
<div class="alert alert--success" role="status">
  <%- include('../partials/icon', { name: 'check-circle' }) %>
  <p>If an account exists for <strong><%= values.email %></strong>, you'll get an email with a reset link shortly. The link expires in <%= security.resetTokenMinutes %> minutes.</p>
</div>
<% if (devMailbox) { %>
<p class="muted text-center">Development mode: check the <a href="/dev/mailbox">dev mailbox</a>.</p>
<% } %>
<% } else { %>
<form action="/forgot-password" method="post" class="form" novalidate data-validate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../partials/field', {
    id: 'email', label: 'Email address', type: 'email', value: values.email, error: errors.email,
    autocomplete: 'email', attrs: 'required maxlength="254" spellcheck="false" autofocus'
  }) %>
  <button type="submit" class="btn btn--primary btn--block" data-loading-text="Sending...">Send reset link</button>
</form>
<% } %>

<p class="auth__footer-link"><a href="/login"><%- include('../partials/icon', { name: 'arrow-left', size: 16 }) %> Back to sign in</a></p>
<%- include('../partials/auth-end') %>
