<%- include('../partials/auth-start', { title: 'Reset password', formNo: 'AP-3A', passwordTools: true }) %>
<% if (locals.invalid) { %>
<div class="status-block">
  <span class="status-block__icon status-block__icon--danger"><%- include('../partials/seal', { id: 'rp', tone: 'red', top: appName.length > 16 ? 'Account Office' : appName, word: 'Void', bottom: 'Link not valid' }) %></span>
  <h1 class="auth__title">This reset link doesn't work</h1>
  <p class="auth__subtitle">
    Reset links expire after <%= security.resetTokenMinutes %> minutes and stop working once they've been used.
    You can ask for a new one below.
  </p>
</div>
<div class="button-stack">
  <a class="btn btn--primary btn--block" href="/forgot-password">Request a new link</a>
  <a class="btn btn--secondary btn--block" href="/login">Back to sign in</a>
</div>
<% } else { %>
<div class="auth__header">
  <h1 class="auth__title">Choose a new password</h1>
  <p class="auth__subtitle">For <strong><%= email %></strong>. You'll be signed out on every other device.</p>
</div>

<form action="/reset-password/<%= token %>" method="post" class="form" novalidate data-validate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <%- include('../partials/password-field', {
    id: 'password', label: 'New password', error: errors.password,
    autocomplete: 'new-password', attrs: 'required minlength="8" maxlength="64" autofocus'
  }) %>

  <%- include('../partials/password-rules', { target: 'password', email }) %>

  <%- include('../partials/password-field', {
    id: 'confirmPassword', label: 'Confirm new password', error: errors.confirmPassword,
    autocomplete: 'new-password', attrs: 'required maxlength="64" data-match="password"'
  }) %>

  <button type="submit" class="btn btn--primary btn--block" data-loading-text="Saving...">Reset password</button>
</form>
<% } %>
<%- include('../partials/auth-end') %>
