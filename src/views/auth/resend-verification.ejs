<%- include('../partials/auth-start', { title: 'Resend verification email', formNo: 'AP-4' }) %>
<div class="auth__header">
  <h1 class="auth__title">Resend verification email</h1>
  <p class="auth__subtitle">Enter the email you signed up with and we'll send a fresh link.</p>
</div>

<% if (locals.formError) { %>
<div class="alert alert--error" role="alert"><%- include('../partials/icon', { name: 'alert' }) %><p><%= formError %></p></div>
<% } %>

<% if (locals.sent) { %>
<div class="alert alert--success" role="status">
  <%- include('../partials/icon', { name: 'check-circle' }) %>
  <p>If <strong><%= values.email %></strong> belongs to an account that still needs verifying, a new link is on its way. Older links no longer work.</p>
</div>
<% if (devMailbox) { %>
<p class="muted text-center">Development mode: check the <a href="/dev/mailbox">dev mailbox</a>.</p>
<% } %>
<% } else { %>
<form action="/verify-email/resend" method="post" class="form" novalidate data-validate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <%- include('../partials/field', {
    id: 'email', label: 'Email address', type: 'email', value: values.email, error: errors.email,
    autocomplete: 'email', attrs: 'required maxlength="254" spellcheck="false"'
  }) %>
  <button type="submit" class="btn btn--primary btn--block" data-loading-text="Sending...">Send verification link</button>
</form>
<% } %>

<p class="auth__footer-link"><a href="/login"><%- include('../partials/icon', { name: 'arrow-left', size: 16 }) %> Back to sign in</a></p>
<%- include('../partials/auth-end') %>
