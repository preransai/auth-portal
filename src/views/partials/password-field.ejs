<%
  // Usage: include('password-field', { id, label, error, autocomplete, attrs, labelAside })
  const fieldError = locals.error;
%>
<div class="field<%= fieldError ? ' field--error' : '' %>">
  <div class="field__label-row">
    <label class="field__label" for="<%= id %>"><%= label %></label>
    <%- locals.labelAside || '' %>
  </div>
  <div class="input-group">
    <input
      class="input input--password"
      id="<%= id %>"
      name="<%= locals.fieldName || id %>"
      type="password"
      autocomplete="<%= locals.autocomplete || 'current-password' %>"
      <% if (fieldError) { %>aria-invalid="true" aria-describedby="<%= id %>-error"<% } %>
      <%- locals.attrs || '' %>>
    <button type="button" class="input-group__toggle" data-toggle-password="<%= id %>" aria-controls="<%= id %>" aria-label="Show password" aria-pressed="false">
      <%- include('icon', { name: 'eye', className: 'icon--show' }) %>
      <%- include('icon', { name: 'eye-off', className: 'icon--hide' }) %>
    </button>
  </div>
  <% if (fieldError) { %>
  <p class="field__error" id="<%= id %>-error"><%- include('icon', { name: 'alert', size: 15 }) %><span><%= fieldError %></span></p>
  <% } %>
</div>
