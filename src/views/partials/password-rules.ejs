<%
  // Live checklist + strength meter, wired up by public/js/password-tools.js.
  // `emailFrom` is the id of an email input on the same form; `email` is used
  // when the address isn't part of the form (reset / change password).
%>
<div class="pw-check" data-password-check="<%= target %>"
  <% if (locals.emailFrom) { %>data-email-input="<%= emailFrom %>"<% } %>
  <% if (locals.email) { %>data-email="<%= email %>"<% } %>>
  <div class="pw-meter" data-strength="0">
    <div class="pw-meter__track" aria-hidden="true">
      <span class="pw-meter__seg"></span><span class="pw-meter__seg"></span><span class="pw-meter__seg"></span><span class="pw-meter__seg"></span>
    </div>
    <p class="pw-meter__label" aria-live="polite">Password strength: <strong data-strength-label>not entered</strong></p>
  </div>
  <ul class="pw-rules" aria-label="Password requirements">
    <li data-rule="length">8 to 64 characters</li>
    <li data-rule="lower">One lowercase letter</li>
    <li data-rule="upper">One uppercase letter</li>
    <li data-rule="number">One number</li>
    <li data-rule="symbol">One symbol</li>
    <li data-rule="email">Not your email name</li>
  </ul>
</div>
