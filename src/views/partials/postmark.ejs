<%
  // Post-office mark: 120px double ring with ring text, the word across the centre and three
  // cancellation waves to the right (216x120). Black ink. Usage:
  // include('postmark', { id, top, word, bottom, className }); id must be unique on the page.
  // Words longer than six letters ("No post") are set smaller so they clear the inner ring.
  const ring = (text) => String(text).toUpperCase();
%><span class="postmark<%= locals.className ? ' ' + className : '' %>" aria-hidden="true"><svg class="postmark__svg" viewBox="0 0 216 120" width="216" height="120" focusable="false"><defs><path id="<%= id %>-t" d="M15.5 60a44.5 44.5 0 0 1 89 0"/><path id="<%= id %>-b" d="M8.5 60a51.5 51.5 0 0 0 103 0"/></defs><g fill="none" stroke="currentColor"><circle cx="60" cy="60" r="57" stroke-width="2"/><circle cx="60" cy="60" r="39"/><path stroke-width="1.5" d="M110 40c9-6 15 6 24 0s15 6 24 0 15 6 24 0 15 6 24 0M114 60c9-6 15 6 24 0s15 6 24 0 15 6 24 0 15 6 24 0M110 80c9-6 15 6 24 0s15 6 24 0 15 6 24 0 15 6 24 0"/></g><g fill="currentColor"><path d="M12.00 57.10L12.68 59.07L14.76 59.10L13.09 60.36L13.70 62.35L12.00 61.15L10.30 62.35L10.91 60.36L9.24 59.10L11.32 59.07Z"/><path d="M108.00 57.10L108.68 59.07L110.76 59.10L109.09 60.36L109.70 62.35L108.00 61.15L106.30 62.35L106.91 60.36L105.24 59.10L107.32 59.07Z"/></g><text class="seal__ring" text-anchor="middle"><textPath href="#<%= id %>-t" startOffset="50%"><%= ring(top) %></textPath></text><text class="seal__ring" text-anchor="middle"><textPath href="#<%= id %>-b" startOffset="50%"><%= ring(bottom) %></textPath></text><text class="postmark__word<%= String(word).length > 6 ? ' postmark__word--long' : '' %>" x="60" y="64.8" text-anchor="middle"><%= ring(word) %></text></svg></span>
