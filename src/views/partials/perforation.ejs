<% const p = perforationDots(text, locals.pitch || 3.2); %><svg class="perforation" width="<%= p.width.toFixed(1) %>" height="<%= p.height.toFixed(1) %>" viewBox="0 0 <%= p.width.toFixed(1) %> <%= p.height.toFixed(1) %>" aria-hidden="true" focusable="false"><% p.dots.forEach((d) => { %><circle cx="<%= d.cx.toFixed(1) %>" cy="<%= d.cy.toFixed(1) %>" r="<%= p.r.toFixed(2) %>"/><% }) %></svg>
