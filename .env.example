# Copy to .env and fill in what you need. Everything is optional in development.

NODE_ENV=development
PORT=3000

# Public URL of the app, used in email links. Defaults to http://localhost:PORT
APP_URL=http://localhost:3000

# Leave empty to run with an in-memory MongoDB (development only).
# Local:  mongodb://127.0.0.1:27017/auth-portal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/auth-portal
MONGODB_URI=

# Required in production. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# SMTP settings, required in production. Outside production every email is also
# kept in the dev mailbox at /dev/mailbox, so these can stay empty locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Auth Portal <no-reply@example.com>"

# Number of reverse proxies in front of the app (Render, Railway, Nginx...).
# Defaults to 1 in production so req.ip and secure cookies work.
TRUST_PROXY=

# Per-IP limits per 15 minutes
LOGIN_RATE_LIMIT=20
EMAIL_RATE_LIMIT=5

# Optional: the name shown in the interface and in emails, and the time zone
# used for every date the app prints. These are the defaults.
# APP_NAME=Auth Portal
# APP_TIME_ZONE=Asia/Kolkata
