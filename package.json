{
  "name": "auth-portal",
  "version": "1.0.0",
  "description": "Login and registration module for Node.js with bcrypt hashing, email verification, account lockout, CSRF protection and an admin panel.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand"
  },
  "keywords": [
    "authentication",
    "express",
    "mongodb",
    "bcrypt",
    "session"
  ],
  "author": "Preran Sai Yarramasu",
  "license": "MIT",
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^6.0.0",
    "dotenv": "^18.0.6",
    "ejs": "^7.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mongoose": "^9.11.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.15"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
